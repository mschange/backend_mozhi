# MySQL：业务事实库；账号应与 docker-compose.yml 或部署实例一致。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mozhi
MYSQL_PASSWORD=<mysql-password>
MYSQL_DATABASE=mo_zhi
DEBUG_MODE=true

# PostgreSQL：只保存 LangGraph checkpoint；连接池上下限在启动时生效。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mozhi
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DATABASE=mo_zhi_checkpoint
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# JWT：secret 必须替换为随机长值；access 与 refresh 使用不同有效期和 token_type。
JWT_SECRET=<long-random-jwt-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Milvus Lite 使用本地文件；独立服务可改为 http://127.0.0.1:19530。
# 维度必须与 embedding provider 输出、现有 collection schema 完全一致。
MILVUS_DB_PATH=./milvus.db
EMBEDDING_DIM=1024

# 聊天模型：OpenAI 兼容配置，当前默认目标是 DeepSeek。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash

# DeepSeek 专用配置；空值会在 config.py 中回退到上面的 OPENAI_*。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 嵌入模型：DashScope OpenAI 兼容模式；空 key 时允许本地哈希回退。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# LangSmith：默认关闭；开启时由启动生命周期写入 LangChain 兼容环境变量。
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mo-zhi

# Tavily：空值表示 Agent 不注册联网搜索工具。
TAVILY_API_KEY=

# MinerU：当前只保留配置，PDF 解析仍由 pypdf 完成。
MINERU_API_TOKEN=

# 运行时目录与业务限制；相对路径统一相对 backend/ 解析。
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=250
SHORT_TERM_MEMORY_N=20

# 应用错误日志：UTF-8、按大小轮转，实际有效级别最低为 ERROR。
LOG_FILE=./logs/app.log
LOG_LEVEL=ERROR
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
